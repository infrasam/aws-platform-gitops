{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts in dev only, prod is updated by promotion",
      "managerFilePatterns": ["/^environments/dev/infrastructure/[^/]+\\.yaml$/"],
      "matchStrings": [
        "chart:\\s*(?<depName>\\S+)\\s+repoURL:\\s*(?<registryUrl>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Tool versions in workflows marked with a renovate comment on the line above",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\\w+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
